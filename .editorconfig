# Editor defaults that match the linters, so files come out of any editor the way
# ruff, pre-commit and .gitattributes expect. See https://editorconfig.org.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 100

[*.{yml,yaml,cff}]
indent_size = 2

# Two trailing spaces are a Markdown line break, so keep them.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
