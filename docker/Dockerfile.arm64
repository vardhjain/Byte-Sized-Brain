# aarch64 (ARM64) image, the architecture of the Raspberry Pi 4 and 5 and of
# cloud ARM servers such as AWS Graviton and Oracle Ampere. Build it under QEMU
# emulation on an x86 host, or natively on ARM hardware.
#
#   # One-time setup on an x86 host, which registers the QEMU handlers.
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
#
#   docker buildx build --platform linux/arm64 -f docker/Dockerfile.arm64 -t bsb:arm64 --load .
#   docker run --rm --platform linux/arm64 \
#       -e BSB_EMULATED=1 -e BSB_DEVICE=qemu-arm64 \
#       -v "$PWD/benchmarks/results:/app/benchmarks/results" \
#       bsb:arm64 bsb run all --smoke
#
# On real ARM hardware drop `--platform` and `BSB_EMULATED`, and the harness
# stamps its rows with emulated=false.
#
# The target platform comes from the build command rather than from a
# `FROM --platform=...` line, because a constant platform there triggers
# Docker's FromPlatformFlagConstDisallowed build check. The check below stops a
# plain `docker build` on an x86 machine from producing a mislabelled image.
#
# The container runs as the unprivileged user `bsb` (uid 1000). On a Linux host
# whose user id is not 1000, make the mounted results folder writable for uid 1000.
#
# Apart from that check, this file matches docker/Dockerfile, so keep the two in step.

# A fixed Python patch release and Debian release keep rebuilds comparable.
# Dependabot proposes updates (see .github/dependabot.yml).
FROM python:3.11.17-slim-trixie

RUN if [ "$(uname -m)" != "aarch64" ]; then \
        echo "Dockerfile.arm64 targets linux/arm64 but this build runs on $(uname -m)." >&2; \
        echo "Build it with docker buildx build --platform linux/arm64 (see the header)." >&2; \
        exit 1; \
    fi

LABEL org.opencontainers.image.title="byte-sized-brain" \
      org.opencontainers.image.description="Post-training quantization benchmarks (aarch64)" \
      org.opencontainers.image.source="https://github.com/vardhjain/Byte-Sized-Brain" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    TF_ENABLE_ONEDNN_OPTS=0 \
    TOKENIZERS_PARALLELISM=false

RUN useradd --create-home --uid 1000 bsb

WORKDIR /app

# Dependencies come first, so editing the source does not reinstall them.
# Every pinned package ships a prebuilt aarch64 wheel (TensorFlow, PyTorch and
# ONNX Runtime included), so no compiler is needed. torch comes from PyTorch's
# CPU-only index to match the x86 image. Its version is read from
# requirements.txt (tr drops a Windows line ending), so the pin lives in one place.
COPY requirements.txt ./
RUN pip install --index-url https://download.pytorch.org/whl/cpu \
        "$(grep -E '^torch==' requirements.txt | tr -d '\r')" \
 && pip install -r requirements.txt

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY configs ./configs
# --no-deps keeps exactly the versions installed from requirements.txt.
RUN pip install --no-deps -e . \
 && mkdir -p artifacts benchmarks/results \
 && chown -R bsb:bsb /app

USER bsb

# By default, prove the whole thing works end to end on a tiny subset.
CMD ["bsb", "run", "all", "--smoke"]
