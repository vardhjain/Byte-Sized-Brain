# These are NEVER committed — they are reproduced by `bsb train|convert`.
artifacts/
*.tflite
*.onnx
*.pb
*.savedmodel/
saved_model/

# Dataset caches downloaded at runtime
data/
.keras/
.cache/
*.npz

# HuggingFace / Trainer scratch
runs/
checkpoint-*/
wandb/

# The ONLY committed outputs are CSVs under benchmarks/results/ and small
# generated charts under docs/images/ — keep those, ignore everything else big.

