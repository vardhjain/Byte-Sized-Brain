# Byte-Sized Brain ignore rules.
#
# Generic directory names (build, dist, data, site and so on) are anchored to the
# repository root with a leading "/". An unanchored rule matches at any depth,
# and an unanchored "data/" once kept src/byte_sized_brain/data out of git and
# broke CI. Dot-directories and distinctive names can stay unanchored because no
# Python package can be named like them.

# Regenerable model artifacts. `bsb train` and `bsb convert` reproduce these
# (including the Hugging Face Trainer scratch), so they are never committed.
/artifacts/
*.tflite
*.onnx
*.h5
*.keras
saved_model/
*.savedmodel/
checkpoint-*/
/runs/
/wandb/

# Dataset caches. Datasets normally cache to ~/.keras and ~/.cache/huggingface,
# so these only guard against a project-local cache.
/data/
.keras/
.cache/

# Smoke-run results are throwaway functional checks. The only committed outputs
# are the full-run CSVs in benchmarks/results/ and the charts in docs/images/.
/benchmarks/results/smoke/

# Python bytecode, build and packaging output.
__pycache__/
*.py[cod]
/build/
/dist/
*.egg-info/
.eggs/

# Test, lint and type-checker caches.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments and local secrets (for example an HF_TOKEN).
.venv/
venv/
.env
.env.*
!.env.example

# Editors and operating systems.
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
.ipynb_checkpoints/

# mkdocs build output.
/site/
