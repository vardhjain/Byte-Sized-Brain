# The Dockerfiles copy only requirements.txt, pyproject.toml, README.md,
# LICENSE, src/ and configs/. Everything below is left out of the build context
# so it stays small and local caches never end up inside an image.
#
# Patterns match from the context root, so nested files need the **/ prefix.
.git
.github
.venv
venv/
**/__pycache__
**/*.py[cod]
**/*.egg-info
.pytest_cache/
.ruff_cache/
.mypy_cache/
artifacts/
benchmarks/
data/
demo/
docs/
site/
tests/
**/*.tflite
**/*.onnx
PROJECT_PLAN.md
